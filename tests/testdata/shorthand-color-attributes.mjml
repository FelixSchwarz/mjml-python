<mjml>
  <mj-head>
    <mj-attributes>
      <mj-text color="#f80" />
      <mj-class name="highlight" container-background-color="#ff0" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#abc">
    <mj-section background-color="#F0F" border="1px solid #abc">
      <mj-column background-color="#fff">
        <mj-text>color from mj-attributes</mj-text>
        <mj-text mj-class="highlight" color="#ABC">color from mj-class</mj-text>
        <mj-button background-color="rgb(255, 0, 0)" color="red">button</mj-button>
        <mj-divider border-color="#123456" />
      </mj-column>
      <mj-group background-color="#dad">
        <mj-column>
          <mj-text color="#0f0">group</mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
  </mj-body>
</mjml>
